{
  "name": "Pixeltable Starter Kit",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "pxt service run", "onAutoForward": "notify" }
  },

  "mounts": [
    "source=pixeltable-data,target=/home/vscode/.pixeltable,type=volume"
  ],

  "containerEnv": {
    "PIXELTABLE_HOME": "/home/vscode/.pixeltable"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/chat-agent/.venv/bin/python"
      }
    }
  }
}
