{
  "sourceRepo": "pixeltable/pixeltable-starter-kit",
  "sourcePath": ".",
  "updated": "2026-08-31",
  "recipes": [
    {
      "id": "video-search",
      "title": "Video search",
      "blurb": "Ingest video, extract frames at 1 FPS, CLIP-index them, search visually. Images get thumbnails and size metadata.",
      "pattern": "video-search",
      "cloudDeploy": true,
      "dirPrefix": "videointel",
      "serviceName": "videointel",
      "entry": "app.py",
      "githubPath": "video-search",
      "scaffold": "uvx pixeltable-new myapp --video",
      "legacyIds": ["video-intel"],
      "secrets": [],
      "tables": [
        { "name": "videos", "columns": { "video": "Video", "title": "String" } },
        { "name": "images", "columns": { "image": "Image", "label": "String" } }
      ],
      "routes": [
        { "path": "/api/ingest", "type": "insert", "table": "videos" },
        { "path": "/api/ingest/image", "type": "insert", "table": "images" },
        { "path": "/api/search/visual", "type": "query" }
      ],
      "sampleCalls": [
        {
          "label": "Insert a video",
          "curl": "curl -X POST \"$PIXELTABLE_API_URL/api/ingest\" -H \"Authorization: Bearer $PIXELTABLE_API_KEY\" -F video=@clip.mp4 -F title=demo"
        }
      ],
      "runtimeImageTag": "recipe-video-search"
    },
    {
      "id": "chat-agent",
      "title": "Chat agent",
      "blurb": "Knowledge, conversation memory, and the LLM answer are tables and computed columns.",
      "pattern": "chat-agent",
      "cloudDeploy": false,
      "dirPrefix": "agent",
      "serviceName": "agent",
      "entry": "app.py",
      "githubPath": "chat-agent",
      "scaffold": "uvx pixeltable-new myapp",
      "legacyIds": [
        "serving",
        "batch",
        "knowledge-base",
        "multimodal-rag",
        "full-stack-showcase",
        "agent",
        "media-indexing",
        "content-pipeline"
      ],
      "secrets": ["ANTHROPIC_API_KEY"],
      "tables": [
        { "name": "knowledge", "columns": { "body": "String", "title": "String", "source": "String" } },
        { "name": "conversations", "columns": { "role": "String", "content": "String", "conversation_id": "String" } },
        { "name": "agent", "columns": { "prompt": "String", "conversation_id": "String" } }
      ],
      "routes": [
        { "path": "/api/ask", "type": "insert", "table": "agent" },
        { "path": "/api/knowledge", "type": "insert", "table": "knowledge" },
        { "path": "/api/knowledge/search", "type": "query" }
      ],
      "sampleCalls": [
        {
          "label": "Add knowledge",
          "curl": "curl -X POST \"$PIXELTABLE_API_URL/api/knowledge\" -H \"Authorization: Bearer $PIXELTABLE_API_KEY\" -H \"Content-Type: application/json\" -d '{\"body\": \"One application file. Insert runs compute.\", \"title\": \"intro\", \"source\": \"docs\"}'"
        }
      ],
      "runtimeImageTag": null
    }
  ]
}
