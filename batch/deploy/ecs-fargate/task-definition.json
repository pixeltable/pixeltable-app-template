{
  "family": "pixeltable-pipeline",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/pixeltable-pipeline-task-role",
  "containerDefinitions": [
    {
      "name": "pipeline",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/pixeltable-pipeline:latest",
      "essential": true,
      "environment": [
        { "name": "PIXELTABLE_HOME", "value": "/tmp/pixeltable" }
      ],
      "secrets": [
        {
          "name": "SERVING_DB_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:pixeltable/serving-db-url"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:pixeltable/openai-api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pixeltable-pipeline",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "pipeline"
        }
      }
    }
  ]
}
